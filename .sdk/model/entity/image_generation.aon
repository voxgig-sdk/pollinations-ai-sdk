            json: "{\"operationId\":\"generateImage\",\"parameters\":[{\"description\":\"The text prompt describing the image to generate\",\"example\":\"A beautiful sunset over mountains\",\"in\":\"path\",\"name\":\"prompt\",\"required\":true,\"schema\":{\"type\":\"string\"}},{\"description\":\"Width of the generated image in pixels\",\"in\":\"query\",\"name\":\"width\",\"required\":false,\"schema\":{\"default\":1024,\"maximum\":2048,\"minimum\":128,\"type\":\"integer\"}},{\"description\":\"Height of the generated image in pixels\",\"in\":\"query\",\"name\":\"height\",\"required\":false,\"schema\":{\"default\":1024,\"maximum\":2048,\"minimum\":128,\"type\":\"integer\"}},{\"description\":\"Seed for reproducible image generation\",\"in\":\"query\",\"name\":\"seed\",\"required\":false,\"schema\":{\"type\":\"integer\"}},{\"description\":\"The AI model to use for generation\",\"in\":\"query\",\"name\":\"model\",\"required\":false,\"schema\":{\"default\":\"flux\",\"type\":\"string\"}},{\"description\":\"Remove Pollinations logo from the generated image\",\"in\":\"query\",\"name\":\"nologo\",\"required\":false,\"schema\":{\"default\":false,\"type\":\"boolean\"}},{\"description\":\"Enhance the prompt automatically\",\"in\":\"query\",\"name\":\"enhance\",\"required\":false,\"schema\":{\"default\":false,\"type\":\"boolean\"}}],\"protocol\":\"http\",\"responses\":{\"200\":{\"content\":{\"image/jpeg\":{\"schema\":{\"format\":\"binary\",\"type\":\"string\"}},\"image/png\":{\"schema\":{\"format\":\"binary\",\"type\":\"string\"}}},\"description\":\"Successfully generated image\"},\"400\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"error\":{\"properties\":{\"code\":{\"description\":\"Error code\",\"type\":\"string\"},\"message\":{\"description\":\"Error message describing what went wrong\",\"type\":\"string\"},\"type\":{\"description\":\"Type of error\",\"type\":\"string\"}},\"type\":\"object\"}},\"type\":\"object\"}}},\"description\":\"Bad request - invalid parameters\"},\"500\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"error\":{\"properties\":{\"code\":{\"description\":\"Error code\",\"type\":\"string\"},\"message\":{\"description\":\"Error message describing what went wrong\",\"type\":\"string\"},\"type\":{\"description\":\"Type of error\",\"type\":\"string\"}},\"type\":\"object\"}},\"type\":\"object\"}}},\"description\":\"Internal server error during image generation\"}},\"security\":[],\"securitySource\":\"definition\"}"
