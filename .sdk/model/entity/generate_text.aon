        {
          contract: {
            id: "POST /"
            json: "{\"operationId\":\"generateText\",\"parameters\":[],\"protocol\":\"http\",\"requestBody\":{\"content\":{\"application/json\":{\"example\":{\"messages\":[{\"content\":\"Write a short poem about artificial intelligence\",\"role\":\"user\"}],\"model\":\"openai\",\"seed\":42,\"temperature\":0.7},\"schema\":{\"properties\":{\"max_tokens\":{\"description\":\"Maximum number of tokens to generate\",\"maximum\":4096,\"minimum\":1,\"type\":\"integer\"},\"messages\":{\"description\":\"Array of message objects for the conversation\",\"items\":{\"properties\":{\"content\":{\"description\":\"The content of the message\",\"type\":\"string\"},\"role\":{\"description\":\"The role of the message sender\",\"enum\":[\"system\",\"user\",\"assistant\"],\"type\":\"string\"}},\"required\":[\"role\",\"content\"],\"type\":\"object\"},\"type\":\"array\"},\"model\":{\"default\":\"openai\",\"description\":\"The language model to use for text generation\",\"enum\":[\"openai\",\"mistral\",\"claude\"],\"type\":\"string\"},\"seed\":{\"description\":\"Seed for reproducible text generation\",\"type\":\"integer\"},\"temperature\":{\"default\":1,\"description\":\"Controls randomness in generation (0.0 to 2.0)\",\"maximum\":2,\"minimum\":0,\"type\":\"number\"}},\"required\":[\"messages\"],\"type\":\"object\"}}},\"required\":true},\"responses\":{\"200\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"choices\":{\"items\":{\"properties\":{\"finish_reason\":{\"enum\":[\"stop\",\"length\",\"content_filter\"],\"type\":\"string\"},\"index\":{\"type\":\"integer\"},\"message\":{\"properties\":{\"content\":{\"description\":\"The content of the message\",\"type\":\"string\"},\"role\":{\"description\":\"The role of the message sender\",\"enum\":[\"system\",\"user\",\"assistant\"],\"type\":\"string\"}},\"required\":[\"role\",\"content\"],\"type\":\"object\"}},\"type\":\"object\"},\"type\":\"array\"},\"created\":{\"description\":\"Unix timestamp of when the generation was created\",\"type\":\"integer\"},\"id\":{\"description\":\"Unique identifier for the generation\",\"type\":\"string\"},\"model\":{\"description\":\"The model used for generation\",\"type\":\"string\"},\"object\":{\"example\":\"chat.completion\",\"type\":\"string\"},\"usage\":{\"properties\":{\"completion_tokens\":{\"description\":\"Number of tokens in the completion\",\"type\":\"integer\"},\"prompt_tokens\":{\"description\":\"Number of tokens in the prompt\",\"type\":\"integer\"},\"total_tokens\":{\"description\":\"Total number of tokens used\",\"type\":\"integer\"}},\"type\":\"object\"}},\"type\":\"object\"}}},\"description\":\"Successfully generated text response\",\"headers\":{\"Content-Type\":{\"schema\":{\"example\":\"application/json\",\"type\":\"string\"}}}},\"400\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"error\":{\"properties\":{\"code\":{\"description\":\"Error code\",\"type\":\"string\"},\"message\":{\"description\":\"Error message describing what went wrong\",\"type\":\"string\"},\"type\":{\"description\":\"Type of error\",\"type\":\"string\"}},\"type\":\"object\"}},\"type\":\"object\"}}},\"description\":\"Bad request - invalid parameters or prompt\"},\"500\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"error\":{\"properties\":{\"code\":{\"description\":\"Error code\",\"type\":\"string\"},\"message\":{\"description\":\"Error message describing what went wrong\",\"type\":\"string\"},\"type\":{\"description\":\"Type of error\",\"type\":\"string\"}},\"type\":\"object\"}},\"type\":\"object\"}}},\"description\":\"Internal server error during text generation\"}},\"security\":[],\"securitySource\":\"definition\"}"
            source: "openapi3"
            version: 1
          }
          method: "POST"
