# Entity: generate_text

main: kit: entity: generate_text: {

  alias: field: {}

  fields: [
    {
      name: "choices"
      req: false
      type: "`$ARRAY`"
    }
    {
      name: "created"
      req: false
      short: "Unix timestamp of when the generation was created"
      type: "`$INTEGER`"
    }
    {
      name: "id"
      req: false
      short: "Unique identifier for the generation"
      type: "`$STRING`"
    }
    {
      name: "max_tokens"
      req: false
      short: "Maximum number of tokens to generate"
      type: "`$INTEGER`"
    }
    {
      name: "messages"
      req: true
      short: "Array of message objects for the conversation"
      type: "`$ARRAY`"
    }
    {
      name: "model"
      req: false
      short: "The model used for generation"
      type: "`$STRING`"
    }
    {
      name: "object"
      req: false
      type: "`$STRING`"
    }
    {
      name: "seed"
      req: false
      short: "Seed for reproducible text generation"
      type: "`$INTEGER`"
    }
    {
      name: "temperature"
      req: false
      short: "Controls randomness in generation (0.0 to 2.0)"
      type: "`$NUMBER`"
    }
    {
      name: "usage"
      req: false
      type: "`$OBJECT`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "generate_text"
  op: {
    create: {
      name: "create"
      points: [
        {
          method: "POST"
          orig: "/"
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
